# =============================================================================
# SERVIO - Environment configuration
# =============================================================================
# Copy this file to `.env` for local development (or configure the same
# variables in your hosting provider's dashboard for staging/production).
#
# Never commit a real `.env` file. Never put real secrets in GitHub.
#
# Variables prefixed with REACT_APP_ are bundled into the CLIENT-SIDE
# JavaScript and are publicly visible in the browser. Never put a secret
# behind a REACT_APP_ variable. Variables without that prefix stay server-side
# only.
# =============================================================================


# -----------------------------------------------------------------------------
# 1) SHARETRIBE - the marketplace engine (REQUIRED)
# -----------------------------------------------------------------------------
# Sign up / log in at https://console.sharetribe.com (or https://www.sharetribe.com/
# to start a plan) and create a marketplace. Under Build > Applications, create a
# new "Client app" to get the Client ID (and Client Secret, if you use
# privileged transitions - the default-negotiation process does, since
# make-offer/counter-offer transitions must run server-side).
#
# The Client ID below is safe to expose to the browser. The Client Secret is
# NOT - it must only ever be set server-side (no REACT_APP_ prefix).
REACT_APP_SHARETRIBE_SDK_CLIENT_ID=change-me
SHARETRIBE_SDK_CLIENT_SECRET=change-me

# -----------------------------------------------------------------------------
# 2) STRIPE - marketplace payments and provider payouts (REQUIRED)
# -----------------------------------------------------------------------------
# Sharetribe uses Stripe Connect under the hood - you do NOT integrate the
# Stripe API directly in this app. Instead:
#   1. Create a Stripe account at https://dashboard.stripe.com (test mode is
#      fine to start).
#   2. In Sharetribe Console, go to Build > Payments and connect that Stripe
#      account. Console asks you for the Stripe SECRET key there directly -
#      it is never stored in this codebase or in these env vars.
#   3. Put the Stripe PUBLISHABLE key here so the client app can render
#      Stripe Elements (the card form) at checkout.
# Get both keys from https://dashboard.stripe.com/apikeys
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_change-me

# -----------------------------------------------------------------------------
# 3) MAPBOX - maps, geocoding, and location search (REQUIRED)
# -----------------------------------------------------------------------------
# Create a free account at https://account.mapbox.com/ and generate an access
# token (Tokens > Create a token - the default public scopes are enough).
# mapProvider is already set to 'mapbox' in src/config/configMaps.js.
REACT_APP_MAPBOX_ACCESS_TOKEN=pk.change-me

# Alternative: if you prefer Google Maps instead of Mapbox, set this AND
# change `mapProvider` to 'googleMaps' in src/config/configMaps.js (or the
# hosted map.json asset in Console).
# REACT_APP_GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# 3b) MONGODB - the new custom backend database (migration in progress)
# -----------------------------------------------------------------------------
# Servio is migrating off Sharetribe to a fully custom Express + MongoDB backend - see
# MIGRATION_PLAN.md at the project root for the phased plan and what's live today.
#
# Phase 1 (current): GET /api/v2/categories reads from this database. Until MONGODB_URI is set,
# that endpoint returns 503 and the homepage transparently falls back to its bundled category
# list - nothing breaks either way.
#
# Create a free MongoDB Atlas cluster at https://www.mongodb.com/cloud/atlas/register, then get
# its connection string (Atlas: Database > Connect > Drivers) and paste it below. Never commit a
# real value here - this var has no REACT_APP_ prefix, so it stays server-side only.
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/servio?retryWrites=true&w=majority
#
# After setting MONGODB_URI (locally or in Render's dashboard), run this once to populate
# categories:
#   node server/scripts/seedCategories.js

# Phase 2 (current): real JWT-based signup/login lives at POST /api/v2/auth/signup and
# POST /api/v2/auth/login (and GET /api/v2/auth/me for the current user), backed by the same
# database. Set JWT_SECRET below - without it, those three endpoints return a 500 explaining why.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=

# -----------------------------------------------------------------------------
# 4) APPLICATION URL (REQUIRED)
# -----------------------------------------------------------------------------
# No trailing slash. Used for SEO/social sharing tags, SSO, and the sitemap.
# Local dev:
REACT_APP_MARKETPLACE_ROOT_URL=http://localhost:3000
# Production, e.g.:
# REACT_APP_MARKETPLACE_ROOT_URL=https://www.servio.com

# -----------------------------------------------------------------------------
# 5) BRANDING
# -----------------------------------------------------------------------------
# This is the fallback used until you configure Console's branding.json asset
# (Design tab) with your own colors/logo, which take precedence once set.
REACT_APP_MARKETPLACE_NAME=SERVIO

# -----------------------------------------------------------------------------
# 6) ENVIRONMENT / BUILD
# -----------------------------------------------------------------------------
# Leave as 'production' for real deployments - the repo's .env.development and
# .env.test override this locally / in CI.
REACT_APP_ENV=production

# Content Security Policy. Use 'block' in production once you've verified
# nothing is broken, 'report' to log violations without blocking, or omit to
# disable CSP entirely.
REACT_APP_CSP=report

# -----------------------------------------------------------------------------
# 7) SOCIAL LOGIN / SSO (OPTIONAL)
# -----------------------------------------------------------------------------
# Facebook Login: create an app at https://developers.facebook.com/apps
# REACT_APP_FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Google Login: create OAuth credentials at https://console.cloud.google.com/apis/credentials
# REACT_APP_GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Advanced: only needed if SERVIO acts as an OpenID Connect proxy for a
# custom SSO integration. See:
# https://www.sharetribe.com/docs/cookbook-social-logins-and-sso/setup-open-id-connect-proxy/
# RSA_PRIVATE_KEY=
# RSA_PUBLIC_KEY=
# KEY_ID=

# -----------------------------------------------------------------------------
# 8) EMAIL
# -----------------------------------------------------------------------------
# Transactional emails for the marketplace (quote received, offer accepted,
# payment confirmation, etc.) are sent by Sharetribe itself using the email
# templates in ext/transaction-processes/*/templates - configure the sender
# name/address and, if desired, a custom domain in Sharetribe Console under
# Build > Email templates / Branding. No separate email provider env vars are
# required for these.
#
# If you later add app-specific emails outside of Sharetribe's transaction
# process emails (e.g. a custom marketing newsletter), add your provider's
# vars here, e.g.:
# SENDGRID_API_KEY=
# EMAIL_FROM_ADDRESS=hello@servio.com

# -----------------------------------------------------------------------------
# 9) FILE STORAGE (OPTIONAL)
# -----------------------------------------------------------------------------
# Listing images, profile photos, and message attachments are uploaded
# through the Sharetribe Marketplace API and stored on Sharetribe's own
# infrastructure by default - no separate file storage account is required.
# Only set this if Sharetribe has given you a dedicated file storage domain
# (it's used to allow that domain in the Content Security Policy):
# FILE_STORAGE_DOMAIN=

# -----------------------------------------------------------------------------
# 10) ANALYTICS & MONITORING (OPTIONAL)
# -----------------------------------------------------------------------------
# Google Analytics 4 (turn off "Enhanced measurements" in GA for accurate
# marketplace event tracking): https://support.google.com/analytics
# REACT_APP_GOOGLE_ANALYTICS_ID=G-change-me

# Plausible Analytics (privacy-friendly alternative): https://plausible.io
# REACT_APP_PLAUSIBLE_DOMAINS=servio.com

# Sentry error monitoring: https://sentry.io
# REACT_APP_SENTRY_DSN=

# -----------------------------------------------------------------------------
# 11) HOSTING / SERVER (set these in your hosting provider's dashboard, not
#     necessarily in a local .env file)
# -----------------------------------------------------------------------------
# Port the Node/Express server listens on (Render/Heroku set this for you
# automatically - do not hard-code it in production).
# PORT=3000

# Trust the reverse proxy's HTTPS termination (needed on Render, Heroku, etc.)
# SERVER_SHARETRIBE_TRUST_PROXY=true
# REACT_APP_SHARETRIBE_USING_SSL=true

# Force HTTPS redirects server-side.
# SERVER_SHARETRIBE_REDIRECT_SSL=true

# Optional HTTP basic-auth gate (useful for staging environments before
# public launch):
# BASIC_AUTH_USERNAME=
# BASIC_AUTH_PASSWORD=

# Disable sitemap generation (rarely needed):
# SITEMAP_DISABLED=false

# -----------------------------------------------------------------------------
# 12) INVOICE PDF DOWNLOADS (self-contained - on by default, no credentials needed)
# -----------------------------------------------------------------------------
# Either party to a paid transaction can download an invoice/receipt PDF for their own records
# (see the "Download invoice (PDF)" button on TransactionPage). The PDF generator itself - HTML
# templates + renderer - was ported from Billzy, a separate invoicing app; see
# server/invoice/*.js and server/api/invoice-pdf.js for exactly what was ported and why. Unlike a
# typical third-party integration, this needs no API key: it runs entirely inside this app using
# Puppeteer (a bundled, headless Chromium) to turn the ported HTML templates into a PDF.
#
# Puppeteer is installed as a normal dependency (see package.json) and downloads its own Chromium
# build during `yarn install` - no Python, no system package manager access required. On most
# hosts (including Render's standard Node web service) this works with zero extra configuration.
# If a deploy target can't launch the bundled Chromium (rare - usually a minimal/stripped Linux
# image missing shared libraries), the "Download invoice" button still renders, but clicking it
# returns a clear "PDF rendering is temporarily unavailable" error instead of a fake/broken file -
# see DEPLOYMENT.md for how to fix that on Render if it ever happens.
#
# Public, non-secret flag - set to false to hide the "Download invoice (PDF)" button everywhere
# and have the endpoint itself return 501, e.g. if you want to disable this feature entirely.
# REACT_APP_INVOICE_PDF_ENABLED=true

# -----------------------------------------------------------------------------
# 13) ADVANCED / RARELY NEEDED (safe to leave unset - sensible defaults apply)
# -----------------------------------------------------------------------------
# Only relevant if Sharetribe has given you a dedicated Enterprise API domain
# instead of the standard shared Sharetribe Marketplace API. Leave unset for
# a normal Sharetribe Console account.
# REACT_APP_SHARETRIBE_SDK_BASE_URL=
# REACT_APP_SHARETRIBE_SDK_ASSET_CDN_BASE_URL=

# Verbose Sharetribe SDK request/response logging - noisy, dev debugging only.
# REACT_APP_SHARETRIBE_SDK_TRANSIT_VERBOSE=false

# Link shown in the app back to Sharetribe Console (rarely needs changing).
# SERVER_SHARETRIBE_CONSOLE_URL=https://console.sharetribe.com

# Caps concurrent outbound sockets from the Node server to the Sharetribe API
# under heavy load. Node/host defaults are fine until you have real
# production traffic data suggesting otherwise.
# MAX_SOCKETS=

# Response caching (in seconds) for the server's proxied asset endpoints
# (branding.json, ride-pricing.json, etc.). 0 = no caching.
# TTL=60
# TTL_ASSETS_BY_VERSION=86400
